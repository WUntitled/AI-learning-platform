# ============================================
# 系统配置（首次使用无需修改）
# ============================================
HOST=0.0.0.0
PORT=8000

# LLM 服务（默认模拟模式，无需API Key）
LLM_PROVIDER=simulation

# 使用 Claude API（可选）
# LLM_PROVIDER=claude
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_API_MODEL=claude-sonnet-5-20251001

# 使用 OpenAI API（可选）
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_API_MODEL=gpt-4o

# 使用 DeepSeek API（可选）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 知识库地址（可选）
# KNOWLEDGE_BASE_URI=http://localhost:8080/api
